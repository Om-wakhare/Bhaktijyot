# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://postgres:yourpassword@localhost:5432/bhaktijyot

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-long-random-secret

ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# ── Razorpay ──────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# ── CORS ──────────────────────────────────────────────────────────────────────
# JSON array of allowed frontend origins
# Dev: CORS_ORIGINS=["http://localhost:5173"]
# Prod: CORS_ORIGINS=["https://your-app.vercel.app"]
CORS_ORIGINS=["http://localhost:5173"]

# ── File storage ───────────────────────────────────────────────────────────────
# In production on Railway: mount a Volume at /data and set these two vars.
# UPLOAD_DIR=/data/uploads
# GENERATED_DIR=/data/generated

# ── Instagram Graph API ────────────────────────────────────────────────────────
# Long-lived token (valid 60 days). Get it from Meta Developer Console.
# Refresh via: POST /api/instagram/refresh-token
INSTAGRAM_ACCESS_TOKEN=
