# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://postgres:yourpassword@localhost:5432/bhaktijyot

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-long-random-secret

ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Failed admin logins allowed per IP within the window before it's blocked (HTTP 429)
# LOGIN_MAX_FAILURES=10
# LOGIN_WINDOW_SECONDS=900

# ── Razorpay ──────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
# Razorpay Dashboard → Webhooks → add https://<backend>/api/orders/razorpay-webhook
# with events payment.captured + order.paid, and paste the same secret here.
# Without it, paid orders still get confirmed by the browser or the background sweep.
RAZORPAY_WEBHOOK_SECRET=

# Stock is reserved at checkout; unpaid orders release it after this many minutes
# ORDER_RESERVATION_MINUTES=30
# RESERVATION_SWEEP_SECONDS=300

# ── CORS ──────────────────────────────────────────────────────────────────────
# JSON array of EXTRA allowed frontend origins (the production Vercel domain is
# always allowed). Never use "*".
# Dev: CORS_ORIGINS=["http://localhost:5173"]
CORS_ORIGINS=["http://localhost:5173"]

# ── File storage ───────────────────────────────────────────────────────────────
# In production on Railway: mount a Volume at /data and set these two vars.
# UPLOAD_DIR=/data/uploads
# GENERATED_DIR=/data/generated

# ── Instagram Graph API ────────────────────────────────────────────────────────
# Long-lived token (valid 60 days). Get it from Meta Developer Console.
# Refresh via: POST /api/instagram/refresh-token (admin login required)
INSTAGRAM_ACCESS_TOKEN=
